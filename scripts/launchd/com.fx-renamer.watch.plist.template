<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fx-renamer.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__ROOT__/scripts/fx-watch.sh</string>
    <string>__FOLDER__</string>
  </array>
  <key>WatchPaths</key>
  <array><string>__FOLDER__</string></array>
  <key>ThrottleInterval</key><integer>2</integer>
  <key>StandardOutPath</key><string>__ROOT__/_tmp/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/_tmp/launchd.err.log</string>
</dict>
</plist>
