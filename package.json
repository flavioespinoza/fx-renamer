  },
  "keywords": ["filename", "rename", "screenshot", "typescript", "esm", "no-regex"],
  "author": "Flavio Espinoza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flavioespinoza/fx-renamer.git"
  },
  "homepage": "https://github.com/flavioespinoza/fx-renamer#readme",
  "bugs": {
    "url": "https://github.com/flavioespinoza/fx-renamer/issues"
  },
  "type": "module",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./fx-name": "./modules/fx-name/fx-name.ts"
  }
